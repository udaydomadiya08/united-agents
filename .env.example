# Your NVIDIA NIM API Key
NVIDIA_API_KEY="nvapi-your-api-key-here"

# To force official tools (OpenClaw, Hermes, etc.) to use NVIDIA NIM instead of OpenAI, 
# set the standard OpenAI variables to point to the NVIDIA endpoint:
OPENAI_API_KEY="nvapi-your-api-key-here"
OPENAI_BASE_URL="https://integrate.api.nvidia.com/v1"
OPENAI_MODEL_NAME="meta/llama-3.1-70b-instruct"
